---
// Ruta de acceso directo: la app es una SPA con enrutado por hash en la página principal.
import Layout from '../layouts/Layout.astro';
const target = `${import.meta.env.BASE_URL}#/configuracion`;
---
<Layout>
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <p style="padding:2rem"><a href={target}>Ir a la sección</a></p>
</Layout>
